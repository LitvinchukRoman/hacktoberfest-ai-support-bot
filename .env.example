DATABASE_URL=postgres://postgres:postgres@localhost:15432/skelar?sslmode=disable
SUPPORT_DEV_TOOLS=true

# AI core: Gemma 4 through the Gemini API. Without GEMINI_API_KEY, or with SUPPORT_FAKE_LLM=true,
# the bot runs on the keyword classifier and templates (offline demo).
# The key comes from Google AI Studio; keep it in the environment, never in git or logs.
GEMINI_API_KEY=
SUPPORT_FAKE_LLM=false
# gemma-4-26b-a4b-it: 98% intent accuracy on the goldset at p95 2.8 s. gemma-4-31b-it was overloaded and slow when measured.
SUPPORT_CLASSIFIER_MODEL=gemma-4-26b-a4b-it
SUPPORT_WRITER_MODEL=gemma-4-26b-a4b-it
# Optional second model, asked when the first fails or is too slow. Empty = fall back to the keyword classifier.
SUPPORT_FALLBACK_MODEL=
SUPPORT_LLM_TEMPERATURE=true
SUPPORT_LLM_SCHEMA=true
# How long the model may "think": MINIMAL, LOW, MEDIUM or HIGH. Without a limit free-text calls time out.
SUPPORT_LLM_THINKING=MINIMAL
SUPPORT_LLM_TIMEOUT=8s

# Retention: fantasm's support billing API (/api/integrations/support/billing). The bot reads what the
# person pays for and may give 7 free days once; cancelling and refunding stay with a support manager.
# Without both values billing is off and every cancellation or refund goes straight to a manager.
# SUPPORT_API_TOKEN must equal fantasm's SUPPORT_API_TOKEN (32+ characters); keep it in the environment, never in git.
# fantasm listens on :8080 by default, so locally run the bot on another PORT.
FANTASM_API_URL=http://localhost:8080
SUPPORT_API_TOKEN=
